NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/portal_hormezinda
FRONTEND_URL=http://localhost:5173

# Use um valor aleatorio forte. Nao reutilize este placeholder.
JWT_SECRET=change-me-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=use-a-different-random-secret-with-at-least-32-bytes

JSON_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100



# Em producao no Render, configure as tres variaveis para armazenamento persistente.
# Sem elas, o desenvolvimento local continua usando backend/src/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Somente para inicializar banco vazio. Nunca coloque senha real neste arquivo example.
DEFAULT_ADMIN_PASSWORD=

# E-mail transacional via API HTTPS da Brevo (compativel com Render Free).
# Nunca coloque a chave real neste arquivo de exemplo ou no Git.
BREVO_API_KEY=change-me
MAIL_FROM_EMAIL=verified-sender@example.com
MAIL_FROM_NAME=Portal Hormezinda
