NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/portal_hormezinda
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-in-production
JSON_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Opcional: se preenchido, os uploads (fotos, banners, etc.) sao salvos no
# Cloudinary em vez do disco local. Necessario em hosts com disco temporario
# (ex.: plano free do Render), senao os arquivos somem a cada novo deploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
